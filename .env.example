# ==============================================================================
# Donatur Helper - Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` (or `.env.local` for local overrides).
# 2. Fill in the values for your environment.
# 3. NEVER commit `.env` or any real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# SUPABASE_URL: Project URL for Supabase API and Edge Functions.
# Source: Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xyzcompanyproject.supabase.co
# Scope: Public / Client-safe (read-only URL)
SUPABASE_URL=

# SUPABASE_PUBLISHABLE_KEY: Public publishable/anon API key for the frontend.
# Used by client-side code and browser applications with PostgreSQL Row Level Security (RLS).
# Source: Supabase Dashboard -> Project Settings -> API -> Project API keys -> `publishable` / `anon` `public`
# Scope: Public / Frontend Client-safe
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SECRET_KEY: Admin secret key (service role) for privileged operations.
# WARNING: This key must NEVER be exposed to the browser/frontend code!
# It is ONLY for Supabase Edge Functions and server-side code, as it bypasses Row Level Security.
# Source: Supabase Dashboard -> Project Settings -> API -> Project API keys -> `secret` / `service_role`
# Scope: SERVER-SIDE ONLY / HIGH SECRET
SUPABASE_SECRET_KEY=

# BACKEND_MODE: Specifies the active backend integration mode.
# Options: `supabase` | `apps_script` (legacy fallback during staged migration)
# Scope: Application runtime configuration
BACKEND_MODE=supabase

# ------------------------------------------------------------------------------
# Resend Email Configuration
# ------------------------------------------------------------------------------
# RESEND_API_KEY: API Key for sending transactional emails via Resend.
# Source: Resend Dashboard -> API Keys (https://resend.com/api-keys)
# WARNING: NEVER expose this key to frontend/browser code! Edge Functions ONLY.
# Scope: SERVER-SIDE ONLY / SECRET
RESEND_API_KEY=

# EMAIL_FROM: Verified sender email address / identity.
# Source: Resend Dashboard -> Domains (e.g. "Donatur Helper <notifikasi@domainanda.org>")
# Scope: Server-side / Edge Function email templates
EMAIL_FROM=

# ------------------------------------------------------------------------------
# Gmail SMTP & Local Email Testing Configuration
# ------------------------------------------------------------------------------
# GMAIL_SMTP_USER: Full Gmail address used for SMTP authentication (e.g. user@gmail.com)
# Scope: SERVER-SIDE ONLY / LOCAL DEV
GMAIL_SMTP_USER=

# GMAIL_SMTP_PASS: 16-character Google App Password (not standard account password)
# Scope: SERVER-SIDE ONLY / SECRET
GMAIL_SMTP_PASS=

# EMAIL_MODE: Mode for email dispatch. Set to 'self_only' for isolated local verification.
# Options: `self_only` | `production` | `disabled`
# Scope: Local development and testing safety guard
EMAIL_MODE=self_only

# EMAIL_TEST_TO: Destination email address for single local test message.
# Scope: Local development testing only
EMAIL_TEST_TO=

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# APP_URL: Base canonical URL of the web application.
# Local: http://localhost:3000 (or http://localhost:4173 / http://localhost:8888)
# Production: https://donatur-helper.pages.dev (or custom domain)
# Scope: Public / Redirect URLs and email link generation
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Optional: Supabase CLI & Deployment Management
# ------------------------------------------------------------------------------
# SUPABASE_PROJECT_REF: Reference ID of the Supabase project (used for CLI deployments/migrations).
# Source: Supabase Dashboard -> Project Settings -> General -> Reference ID
# Scope: Local development CLI / CI/CD pipeline
SUPABASE_PROJECT_REF=

# SUPABASE_ACCESS_TOKEN: Personal access token for Supabase CLI automation.
# Source: Supabase Dashboard -> Account -> Access Tokens
# Scope: CI/CD / Supabase CLI local login
SUPABASE_ACCESS_TOKEN=
XLSX_SOURCE_PATH=data/source/donatur-helper.xlsx